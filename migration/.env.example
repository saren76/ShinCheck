# Copy to .env after setting up Supabase and an AI provider.
# Do not commit real secrets to GitHub.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only. Never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Pick an OpenAI-compatible provider; server-only secret.
# Example: OpenAI, Gemini via a compatible endpoint, or OpenRouter.
AI_API_KEY=YOUR_AI_PROVIDER_KEY
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional local server configuration
PORT=3000
